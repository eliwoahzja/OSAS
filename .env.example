# The frontend reads its Supabase URL/anon key from js/config.js (public values).
# Secrets for the send-notification Edge Function are set with:
#   supabase secrets set MAILEROO_API_KEY=... MAILEROO_FROM="Name <address@verified-domain>"
# Optional: ALLOWED_ORIGIN=https://your-site.example  (restrict CORS for the function)

# Account-lockout Edge Function (auth-gateway). Deploy with:
#   supabase functions deploy auth-gateway
# Secrets (set once):
#   supabase secrets set SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=...
#   supabase secrets set MAILEROO_API_KEY=... MAILEROO_FROM="Saint Agnes Academy OSAS <osas@your-verified-domain>"
# Or SMTP (port 465 only on hosted Supabase):
#   supabase secrets set SMTP_HOST=... SMTP_PORT=465 SMTP_USER=... SMTP_PASS=... SMTP_FROM="..."
# Optional: APP_URL=https://your-site.example  (unlock-link base in the email)
# Optional: AUTH_FN_URL=https://<project>.functions.supabase.co/auth-gateway  (frontend override)
